# Python bytecode & cache
__pycache__/
*.py[cod]
*.class
*.so
*.cache

# Virtual environment
venv/
env/
.venv/

# Session recordings and local runtime logs (large runtime videos ignored)
outputs/videos/*
!outputs/videos/.gitkeep
!outputs/videos/sample_demo.mp4
outputs/logs/*
!outputs/logs/.gitkeep
!outputs/logs/sample_run_log.jsonl
outputs/logs/*.pid

# Training run artifacts
runs/

# IDE & OS files
.vscode/
.idea/
.DS_Store
Thumbs.db

# Secrets & local env
.env
*.local
